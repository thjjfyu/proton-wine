MODULE    = wineandroid.drv
UNIXLIB   = wineandroid.so
IMPORTS   = ntoskrnl
UNIX_LIBS = -lwin32u $(PTHREAD_LIBS)

SOURCES = \
	build.gradle.in \
	device.c \
	dllmain.c \
	init.c \
	keyboard.c \
	opengl.c \
	window.c \
	wine.svg

# Keep driver build enabled, but skip legacy Gradle APK target in CI.
EXTRA_TARGETS =
